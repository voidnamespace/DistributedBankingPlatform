{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": false
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "SegmentationDb": "Host=localhost;Port=5436;Database=segmentationdb;Username=postgres;Password=postgres"
  },
  "Messaging": {
    "Enabled": true
  },
  "Seeding": {
    "Segments": {
      "Enabled": true
    },
    "UserMetrics": {
      "Enabled": false
    }
  },
  "Simulation": {
    "Enabled": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest"
  },
  "Segments": {
    "EvaluationIntervalSeconds": 60,
    "ActiveUsersWindowSeconds": 2592000,
    "RiskUsersWindowSeconds": 7776000
  },
  "SegmentEvaluationBackgroundService": {
    "Enabled": true
  },
  "AllowedHosts": "*"
}
